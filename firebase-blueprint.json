{
  "entities": {
    "PlatformConfig": {
      "title": "PlatformConfig",
      "description": "Global Qolock Maradi tariffs, WhatsApp support numbers, student WhatsApp group link, and Mobile Money coordinates.",
      "type": "object",
      "properties": {
        "visitPassPrice": { "type": "number", "description": "Pass Visite price in FCFA (default 2000)." },
        "topListingPrice": { "type": "number", "description": "Annonce TOP boost price in FCFA (default 1000)." },
        "topListingDurationDays": { "type": "number", "description": "Duration in days for Annonce TOP highlight (default 7)." },
        "contractPrice": { "type": "number", "description": "Legacy optional contract model price (service discontinued)." },
        "whatsappNumber": { "type": "string", "maxLength": 40, "description": "Primary WhatsApp support number." },
        "whatsappSecondaryNumber": { "type": "string", "maxLength": 40, "description": "Secondary WhatsApp support number." },
        "whatsappGroupUrl": { "type": "string", "maxLength": 300, "description": "Official Qolock Maradi student WhatsApp group invite link." },
        "whatsappGroupLink": { "type": "string", "maxLength": 300, "description": "Legacy alias for official WhatsApp group invite link." },
        "mtnNumber": { "type": "string", "maxLength": 60, "description": "MTN Mobile Money payment number." },
        "moovNumber": { "type": "string", "maxLength": 60, "description": "Moov Money merchant/transfer number." },
        "airtelNumber": { "type": "string", "maxLength": 60, "description": "Airtel Money Niger merchant/transfer number." },
        "nitaAccount": { "type": "string", "maxLength": 120, "description": "Nita / MyNita / Amana Express / Al-Izza recipient." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "visitPassPrice",
        "topListingPrice",
        "whatsappNumber",
        "moovNumber",
        "airtelNumber",
        "nitaAccount",
        "updatedAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile and account role of a Qolock Maradi user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "accountType": { "type": "string", "enum": ["tenant", "landlord"] },
        "neighborhood": { "type": "string", "maxLength": 80 },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "suspendedReason": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "photoURL", "accountType", "neighborhood", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document storing user email, primary phone, and linked verified phones.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 40 },
        "verifiedPhones": {
          "type": "array",
          "description": "Additional verified E.164 phone numbers linked to the account (max 5)."
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "phone", "updatedAt"]
    },
    "Listing": {
      "title": "Listing",
      "description": "Housing, room, annex, apartment, or shared house offer in Maradi.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "maxLength": 4000 },
        "neighborhood": { "type": "string", "minLength": 1, "maxLength": 80 },
        "locationDetails": { "type": "string", "maxLength": 200 },
        "propertyType": {
          "type": "string",
          "enum": ["chambre", "maison", "appartement", "maison_partagee", "annexe", "studio", "colocation", "autre"]
        },
        "priceFcfa": { "type": "number" },
        "depositMonths": { "type": "number" },
        "availableSpots": { "type": "number" },
        "roomsCount": { "type": "number" },
        "availability": { "type": "string", "maxLength": 80 },
        "amenities": { "type": "array" },
        "photos": { "type": "array" },
        "videos": { "type": "array" },
        "bathroomType": { "type": "string", "enum": ["interne", "externe", "partagee"] },
        "toiletType": { "type": "string", "enum": ["interne", "externe"] },
        "furnished": { "type": "string", "enum": ["non_meuble", "semi_meuble", "meuble"] },
        "waterElectricity": { "type": "string", "enum": ["inclus", "compteur_individuel", "partage"] },
        "surfaceSqm": { "type": "number" },
        "roommatePreference": { "type": "string", "enum": ["mixte", "etudiants", "femmes", "hommes", "jeunes_actifs"] },
        "houseRules": { "type": "string", "maxLength": 1000 },
        "status": {
          "type": "string",
          "enum": ["pending", "in_review", "needs_correction", "published", "reserved", "rented", "rejected", "suspended"]
        },
        "moderationReason": { "type": "string", "maxLength": 300 },
        "moderationHistory": {
          "type": "array",
          "description": "Bounded listing moderation decision log (max 12)."
        },
        "validatedByName": { "type": "string", "maxLength": 100 },
        "validatedByEmail": { "type": "string", "maxLength": 200 },
        "validatedAtIso": { "type": "string", "maxLength": 40 },
        "isVerifiedQolock": { "type": "boolean" },
        "isTop": { "type": "boolean" },
        "topRequested": { "type": "boolean" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "description",
        "neighborhood",
        "propertyType",
        "priceFcfa",
        "depositMonths",
        "availableSpots",
        "amenities",
        "photos",
        "status",
        "isVerifiedQolock",
        "isTop",
        "topRequested",
        "ownerId",
        "ownerName",
        "createdAt",
        "updatedAt"
      ]
    },
    "ListingPrivateContact": {
      "title": "ListingPrivateContact",
      "description": "Landlord phone number isolated until Pass Visite verification.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "contactName": { "type": "string", "maxLength": 100 },
        "contactPhone": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "contactName", "contactPhone", "updatedAt"]
    },
    "ListingPrivateVerification": {
      "title": "ListingPrivateVerification",
      "description": "Private depositor verification PII (phone, WhatsApp, address, depositor role, authorization justification) readable strictly by Admin and listing owner.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "contactName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "contactPhone": { "type": "string", "minLength": 1, "maxLength": 40 },
        "contactWhatsapp": { "type": "string", "maxLength": 40 },
        "depositorAddress": { "type": "string", "minLength": 1, "maxLength": 200 },
        "depositorStatus": { "type": "string", "enum": ["proprietaire", "demarcheur", "representant"] },
        "authorizationNote": { "type": "string", "maxLength": 600 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "contactName", "contactPhone", "depositorAddress", "depositorStatus", "authorizationNote", "updatedAt"]
    },
    "ListingVideoClip": {
      "title": "ListingVideoClip",
      "description": "Compressed mobile-ready video clip stored in a dedicated subcollection to keep listing queries lightweight.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
