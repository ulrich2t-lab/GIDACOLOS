      "properties": {
        "orderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "createdAt"]
    },
    "PassAccess": {
      "title": "PassAccess",
      "description": "Admin-granted unlock record for verified Pass Visite or Contract download.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "listingId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "listingId", "orderId", "grantedAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Suspicious listing report submitted by a tenant or user.",
      "type": "object",
      "properties": {
        "listingId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "listingTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "reporterId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reporterName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "reason": { "type": "string", "enum": ["fausse_annonce", "arnaque_prix", "deja_loue", "contenu_inapproprie", "autre"] },
        "details": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["open", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "listingId",
        "listingTitle",
        "reporterId",
        "reporterName",
        "reason",
        "details",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlatformActivity": {
      "title": "PlatformActivity",
      "description": "Audit log of actions on Qolock Maradi.",
      "type": "object",
      "properties": {
        "actorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "action": { "type": "string", "minLength": 1, "maxLength": 100 },
        "targetTitle": { "type": "string", "maxLength": 160 },
        "targetType": { "type": "string", "enum": ["listing", "order", "report", "config", "user", "coloc", "community", "rental", "review"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorId", "actorName", "action", "targetTitle", "targetType", "createdAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "In-app notification sent to a user on listing moderation, payment verification, roommate activity, or account updates.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "enum": ["listing", "payment", "coloc", "account", "system"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "targetId": { "type": "string", "maxLength": 128 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "category", "title", "message", "read", "createdAt"]
    },
    "AdminAlert": {
      "title": "AdminAlert",
      "description": "Admin-only alert created when a user submits or resubmits content for mandatory moderation.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "new_listing",
            "resubmitted_listing",
            "rental_confirmed",
            "new_coloc_profile",
            "resubmitted_coloc_profile",
            "new_coloc_request",
            "new_comment",
            "new_review"
          ]
        },
        "listingId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "listingTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "neighborhood": { "type": "string", "maxLength": 80 },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "depositorStatus": { "type": "string", "enum": ["proprietaire", "demarcheur", "representant"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "listingId", "listingTitle", "neighborhood", "ownerId", "ownerName", "read", "createdAt"]
    },
    "RentalConfirmation": {
      "title": "RentalConfirmation",
      "description": "Verified rental confirmation record triggering the official WhatsApp community welcome block for the tenant.",
      "type": "object",
      "properties": {
        "listingId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "listingTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
        "neighborhood": { "type": "string", "minLength": 1, "maxLength": 80 },
        "priceFcfa": { "type": "number" },
        "tenantId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tenantName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "tenantPhone": { "type": "string", "maxLength": 40 },
        "landlordId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "landlordName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "welcomeMessage": { "type": "string", "minLength": 1, "maxLength": 500 },
        "confirmedById": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "confirmedByName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "confirmedByEmail": { "type": "string", "maxLength": 200 },
        "confirmedAtIso": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "listingId",
        "listingTitle",
        "neighborhood",
        "priceFcfa",
        "tenantId",
        "tenantName",
        "landlordId",
        "landlordName",
        "welcomeMessage",
        "confirmedById",
        "confirmedByName",
        "confirmedAtIso",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/platformConfig/{configId}": {
      "schema": { "$ref": "#/entities/PlatformConfig" },
      "description": "Global platform pricing, WhatsApp community link, and contact settings."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public user profiles."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection."
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Housing, room, annex, apartment, and shared house offers in Maradi."
    },
    "/listings/{listingId}/private/{docId}": {
      "schema": { "$ref": "#/entities/ListingPrivateContact" },
      "description": "Isolated landlord phone contact unlocked after Pass Visite verification."
    },
    "/listings/{listingId}/videoClips/{clipId}": {
      "schema": { "$ref": "#/entities/ListingVideoClip" },
      "description": "Mobile-optimized video tour clips attached to a listing."
    },
    "/listings/{listingId}/colocInterests/{userId}": {
      "schema": { "$ref": "#/entities/ColocInterest" },
      "description": "Moderated roommate candidates introducing themselves for a shared house or colocation listing."
    },
    "/listings/{listingId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ListingReview" },
      "description": "Moderated public user reviews and comments on a housing listing."
    },
    "/colocProfiles/{profileId}": {
      "schema": { "$ref": "#/entities/ColocProfile" },
      "description": "Moderated community roommate matching board for Maradi."
    },
    "/colocProfiles/{profileId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ColocMessage" },
      "description": "Coordination messages on roommate profiles."
    },
    "/colocConversations/{convId}": {
      "schema": { "$ref": "#/entities/ColocConversation" },
      "description": "Private 1-to-1 roommate conversations."
    },
    "/colocConversations/{convId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ColocPrivateMessage" },
      "description": "Messages inside an accepted roommate conversation."
    },
    "/colocMeetings/{meetingId}": {
      "schema": { "$ref": "#/entities/ColocMeeting" },
      "description": "Public-place meeting proposals between future roommates."
    },
    "/colocReports/{reportId}": {
      "schema": { "$ref": "#/entities/ColocReport" },
      "description": "Abuse and suspicious behavior reports in roommate profiles, chats, or meetings."
    },
    "/communityPosts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityPost" },
      "description": "Student community mutual aid board."
    },
    "/serviceOrders/{orderId}": {
      "schema": { "$ref": "#/entities/ServiceOrder" },
      "description": "Pass Visite and TOP boost orders (legacy contract archives read-only)."
    },
    "/paymentRefLocks/{refKey}": {
      "schema": { "$ref": "#/entities/PaymentRefLock" },
      "description": "Deduplication locks preventing reuse of the same transaction reference."
    },
    "/passAccess/{accessId}": {
      "schema": { "$ref": "#/entities/PassAccess" },
      "description": "Admin-verified unlock records keyed by {userId}_{listingId}."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "User reports of suspicious listings."
    },
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/PlatformActivity" },
      "description": "Chronological admin activity log."
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Private user notifications for listing decisions, payments, roommate requests, and account updates."
    },
    "/adminAlerts/{alertId}": {
      "schema": { "$ref": "#/entities/AdminAlert" },
      "description": "Admin alerts for newly submitted or resubmitted listings awaiting verification."
    },
    "/rentalConfirmations/{confId}": {
      "schema": { "$ref": "#/entities/RentalConfirmation" },
      "description": "Confirmed rental agreements granting access to the official WhatsApp community link for confirmed tenants."
    }
  }
}
